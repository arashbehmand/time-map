# Tiles and glyphs (proxied map data)
MAPBOX_TILES_TOKEN=pk.your_tiles_token
# Matrix and Isochrone (server-side routing)
MAPBOX_ROUTING_TOKEN=pk.your_routing_token
# Older single-token setups: used for both when the two above are unset
# MAPBOX_ACCESS_TOKEN=pk.your_token_here

# ── Limits (all optional; defaults in server/settings.py) ──────────
# Where spend counters live. On Railway, point this at a mounted volume so a redeploy
# does not reset this month's counts.
# USAGE_DB_PATH=/data/usage.sqlite3
# Number of proxies in front of the app that append to X-Forwarded-For (Railway: 1).
# 0 means "use the socket peer" and every visitor shares one per-IP bucket.
# Default: 1 when Railway's environment variables are present, else 0.
# TRUSTED_PROXY_HOPS=1
# CLIENT_IP_HEADER=x-forwarded-for
# Monthly caps in each API's billing unit (Matrix: elements; others: requests).
# MATRIX_MONTHLY_BUDGET=90000
# ISOCHRONE_MONTHLY_BUDGET=90000
# TILES_MONTHLY_BUDGET=180000
# GLYPHS_MONTHLY_BUDGET=180000   # an abuse bound; a refused glyph range is served empty (no labels)
# GEOCODE_MONTHLY_BUDGET=40000
# Daily caps default to monthly // 28. Override per API:
# MATRIX_DAILY_BUDGET=3214
# Per-IP requests per minute: PER_IP_SOLVE_PER_MIN, PER_IP_ISOCHRONES_PER_MIN,
# PER_IP_WARP_PARAMS_PER_MIN, PER_IP_GEOCODE_PER_MIN, PER_IP_TILES_PER_MIN, PER_IP_GLYPHS_PER_MIN
# MAX_SOLVE_ELEMENTS=4000
# Most of one API's daily budget a single client (IP or IPv6 /64) may use (0-1).
# CLIENT_DAILY_SHARE=0.25

# Place search (Nominatim). Must identify the app; add a contact address before deploying.
# GEOCODER_USER_AGENT=time-map/1.0 (+https://github.com/arashbehmand/time-map; you@example.com)
